# Meta / Facebook reporting credentials.
# Copy to .env and fill in. See meta/SETUP.md for how to create the tokens.
# Read by meta/ads-report.mjs, meta/dms-report.mjs, and meta/dashboard.

# Ads (System User token, read-only: ads_read + business_management)
META_ACCESS_TOKEN=your-system-user-token-here
META_AD_ACCOUNT_ID=act_123456789
META_API_VERSION=v23.0

# Messenger DMs (Page token: pages_messaging + pages_manage_metadata)
META_PAGE_ACCESS_TOKEN=your-page-access-token-here
META_PAGE_ID=123456789
